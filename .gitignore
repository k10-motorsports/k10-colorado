# python
__pycache__/
*.pyc
.venv/
.DS_Store

# Blender + build artifacts (all regenerable from source + scripts)
*.blend
*.blend1
tracks/*/blender/
tracks/*/build/

# heavy meshes / exports (never in git; kn5 ships via GitHub Releases)
*.obj
*.fbx
*.kn5
*.mtl
*.tif

# TreeFX/GrassFX: third-party .bin tree MODELS are USER-SUPPLIED + licensed — NEVER commit them.
# We only generate config that REFERENCES them by filename (extension/trees/trees.txt + [TREES]).
# The user drops licensed models into the installed track's extension/trees/. See docs/TREEFX-FORMAT.md.
*.bin

# keep in git: tracks/*/track.config.json, tracks/*/source/**, tracks/*/data/centerline*.{geojson,json},
# tracks/*/data/heightfield.* (real-elevation cache), and everything under scripts/ and blender/.

# regenerable debug renders / audit (build outputs, not source)
tracks/*/data/*.svg
tracks/*/data/audit.json
# conformed-ground heightfield, rebuilt by the mesh stage (like track.obj)
tracks/*/data/ground.local.json
# TreeFX sidecar (real tree placements), rebuilt by build_env; consumed by ext_config
tracks/*/data/treefx.json
.engine/
